# Copier en ".env" et adapter. Le projet fonctionne sans ce fichier
# (valeurs par défaut adaptées au développement local avec SQLite).

DJANGO_SECRET_KEY=change-moi-en-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# Base de données — par défaut SQLite si ces lignes restent commentées.
# Pour MySQL (cible de production), décommenter et adapter :
# DB_ENGINE=mysql
# DB_NAME=gestionnaire_conges
# DB_USER=conges_user
# DB_PASSWORD=change-moi
# DB_HOST=localhost
# DB_PORT=3306
# Voir "Basculer vers MySQL" dans le README pour la création de la base/utilisateur.

# E-mail — par défaut, les notifications s'affichent dans la console du
# serveur de développement. Pour un envoi SMTP réel :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=conges@delifood-agro.local

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
